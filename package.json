{
  "name": "file-viewer-desktop",
  "version": "1.0.0",
  "description": "Offline-first file viewer for Windows - Office, PDF, CAD, archives, email, 3D, media and more",
  "main": "electron/main.js",
  "author": "File Viewer Desktop",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:web": "node scripts/build-web.js",
    "build:win": "electron-builder --win --x64",
    "build:win-portable": "electron-builder --win portable --x64",
    "build:all": "npm run build:web && npm run build:win",
    "dist:web": "node scripts/copy-web.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fileviewer.desktop",
    "productName": "File Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "File Viewer"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer"
      },
      {
        "ext": "doc",
        "name": "Word Document",
        "description": "Microsoft Word 97-2003 Document",
        "role": "Viewer"
      },
      {
        "ext": "docx",
        "name": "Word Document",
        "description": "Microsoft Word Document",
        "role": "Viewer"
      },
      {
        "ext": "xls",
        "name": "Excel Spreadsheet",
        "description": "Microsoft Excel 97-2003 Spreadsheet",
        "role": "Viewer"
      },
      {
        "ext": "xlsx",
        "name": "Excel Spreadsheet",
        "description": "Microsoft Excel Spreadsheet",
        "role": "Viewer"
      },
      {
        "ext": "ppt",
        "name": "PowerPoint Presentation",
        "description": "Microsoft PowerPoint 97-2003 Presentation",
        "role": "Viewer"
      },
      {
        "ext": "pptx",
        "name": "PowerPoint Presentation",
        "description": "Microsoft PowerPoint Presentation",
        "role": "Viewer"
      },
      {
        "ext": "ofd",
        "name": "OFD Document",
        "description": "Open Fixed-layout Document",
        "role": "Viewer"
      },
      {
        "ext": "dwg",
        "name": "CAD Drawing",
        "description": "AutoCAD Drawing",
        "role": "Viewer"
      },
      {
        "ext": "dxf",
        "name": "CAD Drawing",
        "description": "Drawing Exchange Format",
        "role": "Viewer"
      },
      {
        "ext": "dwf",
        "name": "CAD Drawing",
        "description": "Design Web Format",
        "role": "Viewer"
      },
      {
        "ext": "zip",
        "name": "Archive",
        "description": "ZIP Archive",
        "role": "Viewer"
      },
      {
        "ext": "rar",
        "name": "Archive",
        "description": "RAR Archive",
        "role": "Viewer"
      },
      {
        "ext": "7z",
        "name": "Archive",
        "description": "7-Zip Archive",
        "role": "Viewer"
      },
      {
        "ext": "eml",
        "name": "Email",
        "description": "Email Message",
        "role": "Viewer"
      },
      {
        "ext": "msg",
        "name": "Email",
        "description": "Outlook Email Message",
        "role": "Viewer"
      },
      {
        "ext": "epub",
        "name": "eBook",
        "description": "EPUB eBook",
        "role": "Viewer"
      },
      {
        "ext": "mobi",
        "name": "eBook",
        "description": "Mobipocket eBook",
        "role": "Viewer"
      },
      {
        "ext": "csv",
        "name": "Data File",
        "description": "Comma Separated Values",
        "role": "Viewer"
      },
      {
        "ext": "json",
        "name": "Data File",
        "description": "JSON Data",
        "role": "Viewer"
      },
      {
        "ext": "xml",
        "name": "Data File",
        "description": "XML Data",
        "role": "Viewer"
      },
      {
        "ext": "txt",
        "name": "Text File",
