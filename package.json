      {
        "ext": "wav",
        "name": "Audio",
        "description": "WAV Audio",
        "role": "Viewer"
      },
      {
        "ext": "flac",
        "name": "Audio",
        "description": "FLAC Audio",
        "role": "Viewer"
      },
      {
        "ext": "mp4",
        "name": "Video",
        "description": "MP4 Video",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "Video",
        "description": "WebM Video",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "Video",
        "description": "Matroska Video",
        "role": "Viewer"
      },
      {
        "ext": "png",
        "name": "Image",
        "description": "PNG Image",
        "role": "Viewer"
      },
      {
        "ext": "jpg",
        "name": "Image",
        "description": "JPEG Image",
        "role": "Viewer"
      },
      {
        "ext": "jpeg",
        "name": "Image",
        "description": "JPEG Image",
        "role": "Viewer"
      },
      {
        "ext": "gif",
        "name": "Image",
        "description": "GIF Image",
        "role": "Viewer"
